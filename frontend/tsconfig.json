{
	"extends": "./node_modules/expo/tsconfig.base",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["nativewind/types"],
		"strict": true,
		"paths": {
			"@/*": ["./*"],
			"tailwind.config": ["./tailwind.config.js"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts"
	],
	"exclude": ["node_modules"]
}
